# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# experiment outputs (generated audio — regenerate with the scripts in each folder)
/v4-test/output/
/candidate-grid/output/
/join-test/output/
/join-test/output-parallel/
*.wav

# Student data — the GitHub repo is public, so these stay local only.
# (Full founder messages, names linked to application numbers.)
/c8-scripts/
/review-tool/sets/*.prepared.json
/review-tool/sets/*.preview.json
/review-tool/feedback/
/candidate-grid/candidates.json
/candidate-grid/results.json
/v4-test/rewrites.json
/v4-test/results.json
