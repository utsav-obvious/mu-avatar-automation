# Copy to .env.local and fill in. Never commit .env.local.

# --- ElevenLabs (both tools) ---
ELEVEN_LABS_API_KEY=your_elevenlabs_api_key_here
# The voice every set is generated with. Changing it changes how all audio sounds.
ELEVEN_LABS_VOICE_ID=your_voice_id_here
# Used only by the old /scrub page (forced alignment)
ELEVEN_LABS_FORCE=your_elevenlabs_api_key_here

# --- Review tool (/review) ---
# Supabase project "mu-script" → Project Settings → API Keys (use the *secret* key; server-side only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
# Shared passcode reviewers type once per browser
REVIEW_PASSCODE=choose_a_passcode
# Claude API key — only for the "Ask Claude" spelling fallback in the Fix panel
CLAUDEAPI_KEY=sk-ant-xxx

# --- Old pronunciation audit tool (/) ---
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_minimax_group_id_here
MINIMAX_VOICE_ID=male-en-001
MINIMAX_MODEL=speech-2.5-hd-preview
